{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "packages/v2/**/*.ts",
    "packages/pipeline/process.ts",
    "packages/pipeline/python-runtime.ts",
    "packages/pipeline/python-runtime-cli.ts",
    "services/v2/**/*.ts",
    "tests/public/**/*.ts",
    "tests/integration/**/*.ts",
    "demo/**/*.ts",
    "scripts/v2-live-smoke.ts"
  ]
}
